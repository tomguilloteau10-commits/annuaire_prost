# ════════════════════════════════════════════════════════════════════════
#  VelvetGirl — réglages du SERVEUR de production
#  Copiez ce fichier en « .env » sur le serveur et remplissez chaque ligne.
#  Guide complet : docs/MISE-EN-LIGNE.md
#  Ne mettez JAMAIS ce fichier rempli sur GitHub.
# ════════════════════════════════════════════════════════════════════════

# Active la configuration de production (HTTPS, sauvegardes…). Ne pas modifier.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# ── Adresse du site ─────────────────────────────────────────────────────
# Votre nom de domaine, sans https:// ni www (ex. velvetgirl.ch).
DOMAIN=velvetgirl.ch
# Adresse e-mail pour le certificat HTTPS (avertissements d'expiration).
ACME_EMAIL=vous@exemple.ch

# ── Base de données ─────────────────────────────────────────────────────
# Mot de passe long et aléatoire (lettres et chiffres uniquement).
# Pour en générer un sur le serveur : openssl rand -hex 24
POSTGRES_PASSWORD=

# ── Secrets de l'application ────────────────────────────────────────────
# Laissez « change-me » : ils sont générés automatiquement au premier
# démarrage et conservés (et sauvegardés) par le serveur.
SESSION_SECRET="change-me"
CSRF_SECRET="change-me"
APP_IP_HASH_SECRET="change-me"
MEDIA_SIGNING_SECRET="change-me"
VERIFICATION_PROVIDER="mock"
MEDIA_STORAGE_DRIVER="local"
MEDIA_LOCAL_PATH="./storage/media"
MEDIA_SIGNED_URL_TTL_SECONDS="120"

# ── E-mails (mot de passe oublié) ───────────────────────────────────────
# Fournis par votre service d'e-mail (Infomaniak, Brevo, Postmark…).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="VelvetGirl <no-reply@velvetgirl.ch>"

# ── Sauvegardes ─────────────────────────────────────────────────────────
# Phrase secrète qui chiffre les sauvegardes. SANS ELLE, AUCUNE SAUVEGARDE
# NE PEUT ÊTRE RESTAURÉE : notez-la dans votre gestionnaire de mots de passe,
# hors du serveur. Pour en générer une : openssl rand -base64 32
BACKUP_PASSPHRASE=
# Heure de la sauvegarde quotidienne (heure suisse) et nombre de jours gardés.
BACKUP_TIME=03:30
BACKUP_KEEP_DAYS=14
# Copie hors du serveur (fortement recommandé) vers un stockage compatible
# S3 (Infomaniak Swiss Backup, Exoscale SOS…). Laissez BACKUP_REMOTE vide
# pour garder les sauvegardes sur le serveur seulement.
BACKUP_REMOTE=
# Exemple : BACKUP_REMOTE=offsite:velvetgirl-sauvegardes
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=Other
# RCLONE_CONFIG_OFFSITE_ENDPOINT=https://s3.exemple.ch
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=

NODE_ENV="production"
