    "accounts:list": "tsx --env-file-if-exists=.env scripts/list-accounts.ts",
    "demo:remove": "tsx --env-file-if-exists=.env scripts/remove-demo-profiles.ts",
    "test-profiles:fill": "tsx --env-file-if-exists=.env scripts/fill-test-profiles.ts",
