# Copiez ce fichier vers .env (ou .env.local) et remplissez des valeurs
# locales. Ne commitez jamais de vraies valeurs de secrets.

# ── Base de données ─────────────────────────────────────────────────────
# Doit pointer vers l'instance Postgres+PostGIS du docker-compose.yml.
DATABASE_URL="postgresql://annuaire:annuaire@localhost:5432/annuaire_prost?schema=public"

# ── Secrets applicatifs ─────────────────────────────────────────────────
# Générez des valeurs aléatoires distinctes, ex: `openssl rand -hex 32`.
# SESSION_SECRET signe les cookies de session.
SESSION_SECRET="change-me-in-a-real-random-value"
# CSRF_SECRET signe les jetons anti-CSRF (double submit cookie).
CSRF_SECRET="change-me-in-a-real-random-value"
# APP_IP_HASH_SECRET sale le hash des adresses IP (jamais d'IP en clair
# stockée — voir ENGINEERING_RULES.md §5).
APP_IP_HASH_SECRET="change-me-in-a-real-random-value"

# ── Vérification 18+ (abstraction VerificationProvider) ─────────────────
# "mock" est la seule valeur supportée en bêta. Un futur prestataire réel
# (sumsub, veriff, pxl_vision, swiss_eid) se branche sans changer le modèle
# de données — voir docs/ARCHITECTURE.md.
VERIFICATION_PROVIDER="mock"

# ── Stockage média (abstraction MediaStorage) ────────────────────────────
# "local" écrit sur le volume Docker monté ci-dessous. "s3" est le point
# de branchement futur (non implémenté en bêta).
MEDIA_STORAGE_DRIVER="local"
MEDIA_LOCAL_PATH="./storage/media"
MEDIA_SIGNED_URL_TTL_SECONDS="120"
# Signe les URLs de médias à durée de vie courte (contrainte #6). Secret
# distinct des autres — un futur backend S3 utiliserait sa propre
# signature native (SigV4) à la place, cette variable disparaîtrait alors.
MEDIA_SIGNING_SECRET="change-me-in-a-real-random-value"

# ── Application ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
